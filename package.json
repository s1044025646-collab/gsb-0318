{
  "name": "ihex-sparse-map",
  "version": "1.0.0",
  "description": "离线 Intel HEX 固件记录解析与稀疏地址映射核验后端（API + CLI）",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
